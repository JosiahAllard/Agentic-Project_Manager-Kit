{
  "BUILD_COMMAND": "./gradlew assemble --console=plain",
  "TEST_COMMAND": "./gradlew check --console=plain",
  "FAST_TEST_COMMAND": "./gradlew test --console=plain",
  "gitignore": [
    ".gradle/",
    "build/",
    "out/",
    "bin/",
    "*.class",
    ".idea/",
    "*.iml",
    ".kotlin/",
    "!gradle/wrapper/gradle-wrapper.jar"
  ],
  "gitattributes": [
    "*.java       text eol=lf",
    "*.kt         text eol=lf",
    "*.kts        text eol=lf",
    "*.gradle     text eol=lf",
    "*.properties text eol=lf",
    "*.xml        text eol=lf",
    "# The wrapper script must stay LF or it fails on Linux CI.",
    "gradlew      text eol=lf",
    "*.jar        binary",
    "*.class      binary"
  ]
}

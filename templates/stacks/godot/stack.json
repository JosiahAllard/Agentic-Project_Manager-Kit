{
  "BUILD_COMMAND": "dotnet build --nologo -nodeReuse:false -c Debug",
  "TEST_COMMAND": "python \"<kit folder>/tools/machine_lock.py\" run --repo <REPO> --slug engine-tests --kind test -- tools\\godot.cmd --headless --path . res://tests/engine_tests.tscn",
  "FAST_TEST_COMMAND": "dotnet test --nologo -c Debug",
  "GODOT_VERSION": "4.7.2",
  "ENGINE_TEST_SCENE": "res://tests/engine_tests.tscn",
  "ENGINE_TEST_PASS_STRING": "ENGINE TESTS OK",
  "gitignore": [
    ".godot/",
    ".mono/",
    "bin/",
    "obj/",
    "/android/",
    "*.tmp",
    "export/",
    ".vs/",
    "*.user"
  ],
  "gitattributes": [
    "*.cs         text eol=lf",
    "*.csproj     text eol=lf",
    "*.sln        text eol=crlf",
    "*.gd         text eol=lf",
    "*.gdshader   text eol=lf",
    "*.tscn       text eol=lf",
    "*.tres       text eol=lf",
    "*.godot      text eol=lf",
    "*.import     text eol=lf",
    "*.uid        text eol=lf",
    "*.glb        binary",
    "*.gltf       text eol=lf",
    "*.fbx        binary",
    "*.blend      binary",
    "*.webp       binary",
    "*.svg        text eol=lf",
    "*.wav        binary",
    "*.ogg        binary",
    "*.mp3        binary",
    "*.ttf        binary",
    "*.otf        binary",
    "*.res        binary",
    "*.scn        binary",
    "*.exr        binary",
    "*.hdr        binary"
  ]
}

{
  "name": "pm-kit",
  "version": "0.1.0",
  "description": "The PM kit as a Claude Code plugin (ARCHITECTURE.md, Packaging). The machine lock MCP server and the generic skills (agents and skills live in claude/); templates, optional tools and knowledge ship beside them (docs/shipping.md).",
  "agents": [
    "./hosts/claude/shell/agents/asset-smith.md",
    "./hosts/claude/shell/agents/coordinator.md",
    "./hosts/claude/shell/agents/consultant.md",
    "./hosts/claude/shell/agents/deep-worker.md",
    "./hosts/claude/shell/agents/lander.md",
    "./hosts/claude/shell/agents/pm.md",
    "./hosts/claude/shell/agents/records.md",
    "./hosts/claude/shell/agents/researcher.md",
    "./hosts/claude/shell/agents/reviewer.md",
    "./hosts/claude/shell/agents/senior-worker.md",
    "./hosts/claude/shell/agents/sound-smith.md",
    "./hosts/claude/shell/agents/spec-writer.md",
    "./hosts/claude/shell/agents/strong-worker.md",
    "./hosts/claude/shell/agents/tech-artist.md",
    "./hosts/claude/shell/agents/test-runner.md",
    "./hosts/claude/shell/agents/worker.md"
  ],
  "skills": ["./hosts/claude/shell/skills/"],
  "hooks": "./hosts/claude/shell/hooks/hooks.json",
  "mcpServers": {
    "machine-lock": {
      "command": "python",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/lock_server.py"]
    }
  }
}

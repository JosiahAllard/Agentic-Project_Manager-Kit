#!/bin/sh
# The kit's git pre-commit hook (docs/ledger.md "Pre-commit check"). Inert unless the repository's
# .kit.json sets ledger.pre_commit_check. This front end uses shell builtins only, so a repository
# that has not opted in starts no other process per commit: no .kit.json, or one whose text never
# names pre_commit_check, exits 0 here. Otherwise githooks/pre-commit.py runs the kit's pre-commit
# checks (kitlib.githooks.precommit). A check added there that must run without that key also needs
# its own condition here. Git runs the hook at the work-tree root.
[ -f .kit.json ] || exit 0
named=
while IFS= read -r line || [ -n "$line" ]; do
    case $line in
        *pre_commit_check*) named=1; break ;;
    esac
done < .kit.json
[ -n "$named" ] || exit 0
if ! command -v python >/dev/null 2>&1; then
    echo "pre-commit: ledger check skipped: no python on PATH" >&2
    exit 0
fi
exec python "${0%/*}/pre-commit.py" "$@"

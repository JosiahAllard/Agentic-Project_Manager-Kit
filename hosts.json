{
  "claude": {
    "default": true,
    "adapter": "hosts.claude.adapter",
    "shell": "hosts/claude/shell",
    "platforms": ["windows"],
    "capabilities": {
      "hook_events": ["PreToolUse", "SessionStart", "SubagentStart"],
      "supports_ask": true,
      "subagent_identity_in_hooks": true,
      "mcp": true,
      "skills": true,
      "agent_format": "markdown"
    },
    "profile": {
      "owner_paths": ["CLAUDE.md", ".claude/"],
      "worktrees_directory": ".claude/worktrees",
      "state_directory": ".claude",
      "process_names": {"windows": ["claude.exe", "node.exe"], "linux": ["claude", "node"]},
      "mcp_tool_format": "mcp__plugin_{plugin}_{server}__{tool}",
      "session_env": "CLAUDE_CODE_SESSION_ID",
      "skills_directory": ".claude/skills",
      "attribution": {
        "name": "Claude",
        "email": "noreply@anthropic.com",
        "model_env": "CLAUDE_AGENT_MODEL",
        "model_pattern": null,
        "session_trailer": {
          "key": "Claude-Session",
          "env": "CLAUDE_CODE_BRIDGE_SESSION_ID",
          "url": "https://claude.ai/code/{id}"
        }
      },
      "agent_name_format": "{plugin}:{name}",
      "session_process": "claude.exe",
      "env_prefixes": ["CLAUDE_", "ANTHROPIC_"],
      "cli_program": "claude",
      "cli_package": "@anthropic-ai/claude-code"
    },
    "hook": {
      "tool_event": "PreToolUse",
      "tool_field": "tool_name",
      "guarded_tools": ["Edit", "Write", "MultiEdit", "NotebookEdit", "Bash", "PowerShell", "Read", "Grep", "mcp__*"],
      "fast_path": "all"
    },
    "tiers": {"light": "haiku", "standard": "sonnet", "strong": "opus", "deep": "opus"}
  },
  "codex": {
    "adapter": "hosts.codex.adapter",
    "shell": "hosts/codex/shell",
    "platforms": ["windows"],
    "capabilities": {
      "hook_events": ["PreToolUse", "SessionStart", "PostCompact", "SubagentStart"],
      "supports_ask": false,
      "subagent_identity_in_hooks": false,
      "mcp": true,
      "skills": true,
      "agent_format": "toml"
    },
    "profile": {
      "owner_paths": ["AGENTS.md", ".codex/"],
      "worktrees_directory": ".codex/worktrees",
      "state_directory": ".codex",
      "process_names": {"windows": ["codex.exe"], "linux": ["codex"]},
      "mcp_tool_format": "mcp__{server}__{tool}",
      "session_env": "CODEX_THREAD_ID",
      "skills_directory": ".codex/skills",
      "attribution": {
        "name": "Codex",
        "email": "noreply@openai.com",
        "model_env": null,
        "model_pattern": "[A-Za-z0-9][A-Za-z0-9._:/-]*",
        "session_trailer": null
      },
      "agent_name_format": "kit-{name}",
      "session_process": "codex.exe",
      "env_prefixes": ["CODEX_", "OPENAI_"],
      "cli_program": "codex",
      "cli_package": "@openai/codex"
    },
    "hook": {
      "tool_event": "PreToolUse",
      "tool_field": "tool_name",
      "guarded_tools": ["apply_patch", "Edit", "Write", "MultiEdit", "NotebookEdit", "Bash", "PowerShell",
                        "exec_command", "shell", "shell_command", "write_stdin", "mcp__*"],
      "fast_path": "unmarked"
    },
    "tiers": {"light": "account-default", "standard": "account-default", "strong": "account-default",
              "deep": "account-default"}
  }
}

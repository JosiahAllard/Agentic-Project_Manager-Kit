{
  "landing": {"shared_paths": ["kitlib/*", "boot/*", "hosts/*", "githooks/*", "kit.json", "hosts.json"], "self_review_max_lines": 150, "gate_once": true},
  "maint_lint": {"gate_time": {"prefix": "KIT-GATE-SLOW", "bound_s": 900, "session": "kit"}},
  "roles": {"lander": {"edit_main_checkout": true, "why": "landers fetch and fast-forward main from their worktree"}},
  "repo": {"name": "Agentic-Project_Manager-Kit"},
  "guard": {"role_policy": true},
  "commit": {"merge_fold": true},
  "doc_index": {"enabled": false},
  "daily_full": {"enabled": true, "bisect": {"max_probes": 5}},
  "preflight": {"report_hooks": ["daily_full:summary_lines"]},
  "worktree_remove": {"build_output": ["__pycache__"]},
  "gate": {
    "smoke_steps": ["kit-suite"],
    "docs_only": {"globs": ["docs/*.md"], "steps": ["kit-suite"]},
    "steps": [
      {
        "name": "kit-suite",
        "always": true,
        "globs": ["*"],
        "reuse": true,
        "cmd": ["{python}", "tools/kit_tests.py", "--select", "--smoke", "-C", "{root}"],
        "full_cmd": ["{python}", "tools/kit_tests.py", "--full", "-C", "{root}"],
        "daily_cmd": ["{python}", "tools/kit_tests.py", "--full", "--both-tiers", "-C", "{root}"],
        "pass": ["kit_tests: OK"]
      }
    ]
  },
  "machine_paths": {
    "fixtures": [
      {"glob": "tests/config/test_linux_paths.py", "hits": ["/home/u"], "why": " (an invented posix home)"},
      {"glob": "tests/guard/linux.py", "hits": ["/home/u,?"], "why": " (an invented posix home)"},
      {"glob": "tests/guard/test_linux_paths.py", "hits": ["/home/u"], "why": " (an invented posix home)"},
      {"glob": "tests/launcher/test_handoff_cli.py", "hits": ["/home/u"], "why": " (an invented posix home)"},
      {"glob": "tests/launcher/test_stop_linux.py", "hits": ["/home/u"], "why": " (an invented posix home)"},
      {"glob": "tests/launcher/test_window_linux.py", "hits": ["/home/u"], "why": " (an invented posix home)"},
      {"glob": "tests/lock/test_store_linux.py", "hits": ["/home/u"], "why": " (an invented posix home)"},
      {"glob": "tests/worktree/test_holders_linux.py", "hits": ["/home/u"], "why": " (an invented posix home)"},
      {"glob": ".kit.json", "hits": ["/home/u", "/home/u,.*"], "why": " (this entry list names the invented homes above)"}
    ]
  }
}

{
  "comment": "tools/kit_tests.py --select: which kit test packages a change runs (kitlib/tooldeps/selftree.py, docs/test-tools.md). A change to this file runs the full suite.",
  "shared_core": ["git", "config", "proc", "lock"],
  "full": [
    "tests/*.py",
    "tests/selection.json",
    "kitlib/*",
    "kitlib/tooldeps/**",
    "tools/tool_deps.py",
    "tools/kit_tests.py",
    "kitlib/gate/**",
    "tools/gate.py"
  ],
  "paths": [
    ["claude/agents/**", ["agents", "roster"]],
    ["claude/skills/**", ["skills"]],
    ["claude/__init__.py", ["pmwatch", "guard"]],
    ["claude/claude_host.py", ["pmwatch"]],
    ["claude/guard_selftest.py", ["guard"]],
    ["claude/hooks/guard.py", ["guard"]],
    ["claude/hooks/pm_session_start.py", ["pmstart"]],
    ["claude/hooks/coordinator_session_start.py", ["coordinatorstart", "plugin"]],
    ["claude/hooks/hooks.json", ["plugin"]],
    [".claude-plugin/plugin.json", ["plugin"]],
    ["claude/hub/hub_backlog.py", ["hubbacklog", "pmstart"]],
    ["claude/hub/hub_notices.py", ["pmwatch"]],
    ["claude/hub/hub_repos.py", ["pmstart"]],
    ["claude/hub/action-hub.html", ["hubtopm", "oldpaths"]],
    ["hub/action-hub.html", ["oldpaths"]],
    ["tests/oldpaths/**", ["oldpaths"]],
    ["templates/**", ["templates", "skills"]],
    ["knowledge/**", ["knowledge"]],
    ["optional/**", ["optional", "knowledge", "skills"]],
    ["tests/optional/**", ["knowledge"]],
    ["tests/**", ["tooldeps"]],
    ["reserve_ui.pyw", ["lockui"]],
    ["tools/*.py", ["skills", "stubs"]],
    ["kitlib/hubsite/**", ["hubsite"]],
    ["kitlib/hubsite/web/**", ["hubsite"]],
    ["tests/hubsite/**", ["hubsite"]],
    ["tools/hub.py", ["hubsite"]],
    ["kitlib/**", ["skills"]]
  ],
  "by_name": ["claude/**", "githooks/**", "mcp/**", "installer/**", ".claude-plugin/**"],
  "prose": ["docs/**", "*.md", ".gitignore"],
  "always": ["scrub"],
  "serial": [],
  "skip_fails": [
    ["tests.lock.test_slot_treekill", "the proof that kill_retry is not needed; its confine() skips when no fake cpu slot fits the gate's affinity, which would silently void it"]
  ],
  "long": [
    "tests.docs.test_budget",
    "tests.backlog.test_store",
    "tests.gate.test_land_queue",
    "tests.syncbase.test_sync",
    "tests.gate.test_land_store",
    "tests.worktree.test_new_worktree",
    "tests.gate.test_hardening",
    "tests.worktree.test_worktree_remove"
  ]
}

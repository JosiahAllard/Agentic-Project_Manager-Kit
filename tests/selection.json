{
  "comment": "tools/kit_tests.py --select: which kit test packages a change runs (kitlib/tooldeps/selftree.py, docs/test-tools.md). A change to this file runs the full suite.",
  "shared_core": ["git", "config", "proc", "lock"],
  "full": [
    "tests/*.py",
    "tests/selection.json",
    "kitlib/*",
    "kitlib/tooldeps/**",
    "tools/tool_deps.py",
    "tools/kit_tests.py",
    "kitlib/gate/**",
    "tools/gate.py"
  ],
  "paths": [
    ["hosts/**", ["host"]],
    ["content/roles/**", ["content", "agents", "roster", "host"]],
    ["content/skills/**", ["content", "skills", "host"]],
    ["hosts/claude/adapter/**", ["content"]],
    ["hosts/claude/shell/agents/**", ["agents", "roster", "content"]],
    ["hosts/claude/shell/skills/**", ["skills", "content"]],
    ["hosts/__init__.py", ["host", "guard"]],
    ["hosts/claude/__init__.py", ["pmwatch", "guard"]],
    ["hosts/claude/shell/hooks/kit_header.py", ["host", "plugin"]],
    ["claude/hooks/*.py", ["host", "guard"]],
    ["boot/**", ["boot", "guard", "host"]],
    ["kit.json", ["content", "kitrelease", "host"]],
    [".claude-plugin/marketplace.json", ["content"]],
    ["hosts/claude/adapter/claude_host.py", ["pmwatch"]],
    ["hosts/claude/adapter/guard_selftest.py", ["guard"]],
    ["hosts/claude/shell/hooks/guard.py", ["guard"]],
    ["hosts/claude/shell/hooks/pm_session_start.py", ["pmstart"]],
    ["hosts/claude/shell/hooks/coordinator_session_start.py", ["coordinatorstart", "plugin"]],
    ["hosts/claude/shell/hooks/hooks.json", ["plugin"]],
    [".claude-plugin/plugin.json", ["plugin"]],
    ["hosts/claude/shell/hub/hub_backlog.py", ["hubbacklog", "pmstart"]],
    ["hosts/claude/shell/hub/hub_notices.py", ["pmwatch"]],
    ["hosts/claude/shell/hub/hub_repos.py", ["pmstart"]],
    ["hosts/claude/shell/hub/action-hub.html", ["hubtopm", "oldpaths"]],
    ["hub/action-hub.html", ["oldpaths"]],
    ["tests/oldpaths/**", ["oldpaths"]],
    ["templates/**", ["templates", "skills"]],
    ["knowledge/**", ["knowledge"]],
    ["optional/**", ["optional", "knowledge", "skills"]],
    ["tests/optional/**", ["knowledge"]],
    ["tests/**", ["tooldeps"]],
    ["reserve_ui.pyw", ["lockui"]],
    ["tools/*.py", ["skills", "stubs"]],
    ["kitlib/**", ["skills"]]
  ],
  "by_name": ["hosts/**", "claude/**", "githooks/**", "mcp/**", "installer/**", ".claude-plugin/**"],
  "prose": ["docs/**", "*.md", ".gitignore"],
  "always": ["scrub"],
  "serial": [],
  "skip_fails": [
    ["tests.lock.test_slot_treekill", "the proof that kill_retry is not needed; its confine() skips when no fake cpu slot fits the gate's affinity, which would silently void it"],
    ["tests.lock.test_release_daemons", "the only proof that the kill path and the release spare a shared build daemon; ReleaseCase.setUp's confine() skips when no fake cpu slot fits the gate's affinity, which would silently void it"]
  ],
  "long": [
    "tests.docs.test_budget",
    "tests.backlog.test_store",
    "tests.gate.test_land_queue",
    "tests.syncbase.test_sync",
    "tests.gate.test_land_store",
    "tests.worktree.test_new_worktree",
    "tests.gate.test_hardening",
    "tests.worktree.test_worktree_remove"
  ]
}
